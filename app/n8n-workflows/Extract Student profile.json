      "parameters": {
        "jsCode": "let raw = $json.result;\n\n// remove ```json and ``` if present\nraw = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\ntry {\n  const parsed = JSON.parse(raw);\n\n  // ensure citizenship is never empty\n  if (!parsed.citizenship || parsed.citizenship === \"\") {\n    parsed.citizenship = \"Unknown\";\n  }\n\n  return [{ json: parsed }];\n\n} catch (e) {\n  return [\n    {\n      json: {\n        error: \"Invalid JSON\",\n        raw: raw,\n      },\n    },\n  ];\n}"
