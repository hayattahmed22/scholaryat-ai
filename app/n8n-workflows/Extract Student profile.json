    {
      "parameters": {
        "jsCode": "const data = $json;\n\nif (!data.matches || !Array.isArray(data.matches)) {\n  return [{ json: { error: \"No matches found\", original: data } }];\n}\n\nconst results = data.matches.map(match => {\n  const title = match.title || \"Scholarship Deadline\";\n  const details = `${match.reason || \"\"}\\n${match.link || \"\"}`.trim();\n\n  let dates = \"\";\n  if (match.deadline) {\n    const start = match.deadline.replace(/-/g, \"\") + \"T090000Z\";\n    const end = match.deadline.replace(/-/g, \"\") + \"T100000Z\";\n    dates = `${start}/${end}`;\n  }\n\n  const calendarLink =\n    `https://calendar.google.com/calendar/render?action=TEMPLATE` +\n    `&text=${encodeURIComponent(title)}` +\n    `&details=${encodeURIComponent(details)}` +\n    `&dates=${encodeURIComponent(dates)}`;\n\n  return {\n    title: match.title,\n    deadline: match.deadline,\n    link: match.link,\n    reason: match.reason,\n    calendar_link: calendarLink\n  };\n});\n\nreturn [{ json: { matches: results } }];"
      },
