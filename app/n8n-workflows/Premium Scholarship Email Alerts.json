    {
      "parameters": {
        "jsCode": "const user = $(\"Get premium users\").first().json;\nconst scholarships = $(\"Get scholarships\").all().map(item => item.json);\nconst sentAlerts = $(\"Get Sent Alerts\").all().map(item => item.json);\n\nconst sentScholarshipIds = new Set(\n  sentAlerts\n    .filter(alert => alert.user_id === user.id)\n    .map(alert => alert.scholarship_id)\n);\n\nconst matches = scholarships.filter(s => {\n  const alreadySent = sentScholarshipIds.has(s.id);\n  if (alreadySent) return false;\n\n  const text = `${s.title} ${s.eligibility} ${s.description}`.toLowerCase();\n  const major = (user.major || \"\").toLowerCase();\n  const interests = user.interests || [];\n\n  return (\n    text.includes(major) ||\n    interests.some(i => text.includes(String(i).toLowerCase()))\n  );\n});\n\nif (matches.length === 0) {\n  return [];\n}\n\nconst emailBody = `\nHi ${user.full_name},\n\nWe found new scholarship opportunities that may match your profile:\n\n${matches.map((s, index) => `\n${index + 1}. ${s.title}\nAmount: ${s.amount}\nDeadline: ${s.deadline}\nWhy it matches: This scholarship matches your major or interests.\nApply here: ${s.link}\n`).join(\"\\n\")}\n\nBest,\nScholayat AI\n`;\n\nreturn [\n  {\n    json: {\n      user_id: user.id,\n      email: user.email,\n      subject: \"New scholarships matched for you 🎓\",\n      body: emailBody,\n      matches: matches.map(s => ({\n        id: s.id,\n        title: s.title\n      })),\n      matches_count: matches.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "id": "45659ad3-d231-4059-a187-81feb4b626d4",
      "name": "Build Email"
    },
